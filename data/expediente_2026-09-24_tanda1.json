aplicado en el motor y lo descartado no se usa como argumento. No saques lecciones de rachas de pocos dias, ni a favor ni en contra. La razon de cada analisis sale SOLO de los datos del partido de hoy.\n", "paquete": {"fecha": "2026-09-24", "mlb": [{"away": "STL", "home": "PIT", "venue_id": 31, "venue_nombre": "PNC Park", "records": {"away": "77-81", "home": "80-78"}, "pitcheo": {"away": {"id": 681517, "nombre": "Kyle Leahy", "era": "3.65", "record": "10-5", "mano": "R", "fip": 3.81, "k_pct": 22.0, "bb_pct": 7.0, "k_bb_pct": 15.0, "bf": 587, "fip_multi": 3.42, "bf_multi": 992}, "home": {"id": 694973, "nombre": "Paul Skenes", "era": "3.91", "record": "10-11", "mano": "R", "fip": 3.53, "k_pct": 27.9, "bb_pct": 6.8, "k_bb_pct": 21.0, "bf": 689, "fip_multi": 2.73, "bf_multi": 1584}}, "bullpen": {"away": {"era": 3.95, "cerrador": {"nombre": "Riley O'Brien", "era": "4.08", "saves": 38}, "fip_core": 1.082, "ip": 416.9}, "home": {"era": 3.63, "cerrador": {"nombre": "Gregory Soto", "era": "3.72", "saves": 16}, "fip_core": 0.405, "ip": 859.6}}, "cuotas_ml": {"PIT": -162, "STL": 140}, "total": {"linea": 7.0, "over": -108, "under": -112, "n_casas": 8}, "spread": {"PIT": {"linea": -1.5, "cuota": 144, "n_casas": 9}, "STL": {"linea": 1.5, "cuota": -167, "n_casas": 9}}, "precio": {"fuente": "consenso_us", "n_casas": 9, "referencia_floja": false, "mejor": {"ml": {"PIT": {"cuota": -157, "casa": "betonlineag"}, "STL": {"cuota": 142, "casa": "betonlineag"}}, "total": {"linea": 7.0, "over": {"cuota": -102, "casa": "betmgm"}, "under": {"cuota": -105, "casa": "bovada"}}, "spread": {"PIT": {"linea": -1.5, "cuota": 152, "casa": "fanduel"}, "STL": {"linea": 1.5, "cuota": -165, "casa": "bovada"}}}, "kalshi": {"ml": {"STL": 144, "PIT": -150}, "total": {"8.5": {"over": 170, "under": -178, "vig_pp": 1.0}, "7.5": {"over": 127, "under": -133, "vig_pp": 1.0}, "6.5": {"over": -133, "under": 127, "vig_pp": 1.0}, "5.5": {"over": -186, "under": 178, "vig_pp": 1.0}, "4.5": {"over": -355, "under": 335, "