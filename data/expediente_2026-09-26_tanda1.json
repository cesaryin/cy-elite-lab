aplicado en el motor y lo descartado no se usa como argumento. No saques lecciones de rachas de pocos dias, ni a favor ni en contra. La razon de cada analisis sale SOLO de los datos del partido de hoy.\n", "paquete": {"fecha": "2026-09-26", "mlb": [{"away": "CIN", "home": "TOR", "venue_id": 14, "venue_nombre": "Rogers Centre", "n": 1, "dh": "N", "rf": null, "records": {"away": "74-86", "home": "78-82"}, "pitcheo": {"away": {"id": 695076, "nombre": "Rhett Lowder", "era": "6.01", "record": "6-12", "mano": "R", "fip": 4.67, "k_pct": 17.4, "bb_pct": 9.3, "k_bb_pct": 8.1, "bf": 581, "fip_multi": 4.53, "bf_multi": 658}, "home": {"id": 702056, "nombre": "Trey Yesavage", "era": "3.67", "record": "5-5", "mano": "R", "fip": 4.19, "k_pct": 23.9, "bb_pct": 11.7, "k_bb_pct": 12.2, "bf": 393, "fip_multi": 3.93, "bf_multi": 443}}, "bullpen": {"away": {"era": 4.28, "cerrador": {"nombre": "Emilio Pagán", "era": "3.38", "saves": 25}, "fip_core": 1.228, "ip": 338.9}, "home": {"era": 3.23, "cerrador": {"nombre": "Louis Varland", "era": "1.27", "saves": 35}, "fip_core": 0.692, "ip": 549.5}}, "cuotas_ml": {"CIN": 139, "TOR": -165}, "total": {"linea": 8.0, "over": -123, "under": 105, "n_casas": 5}, "spread": {"CIN": {"linea": 1.5, "cuota": -152, "n_casas": 9}, "TOR": {"linea": -1.5, "cuota": 127, "n_casas": 9}}, "precio": {"fuente": "consenso_us", "n_casas": 9, "referencia_floja": false, "mejor": {"ml": {"CIN": {"cuota": 149, "casa": "lowvig"}, "TOR": {"cuota": -148, "casa": "betrivers"}}, "total": {"linea": 8.0, "over": {"cuota": -118, "casa": "draftkings"}, "under": {"cuota": 107, "casa": "lowvig"}}, "spread": {"CIN": {"linea": 1.5, "cuota": -145, "casa": "betus"}, "TOR": {"linea": -1.5, "cuota": 134, "casa": "fanduel"}}}, "kalshi": {"ml": {"TOR": -150, "CIN": 144}, "total": {"8.5": {"over": 104, "under": -108, "vig_pp": 1.0}, "7.5": {"over": -133, "under": 127, "vig_pp": 1.0}, "6.5": {"over": -203, "under": 194, "vig_pp": 1.0}, "5.5": {"over": -300, "under": 285, "vig_pp": 1.0}, "4.5":